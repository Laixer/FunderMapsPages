{
  "name": "fundermaps-pages",
  "version": "1.0.0",
  "description": "FunderMaps marketing site",
  "repository": "git@codepot.nl:developers/frontend/boilerplate.git",
  "author": "Lemone B.V.",
  "license": "MIT",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "engines": {
    "node": ">= 20.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "clean:output": "rimraf dist",
    "start": "pnpm clean:output && parcel src/artikelen.html src/index.html src/apps.html src/apps-quickscan.html src/apps-herstelkosten.html src/media-library.html src/more-info.html src/nationaal-herstelregister.html src/privacy-statement.html src/terms-conditions.html -p 8000",
    "build": "parcel build src/index.html --public-url ./",
    "lint:js": "eslint \"src/**/*.{js,mjs}\"",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint": "pnpm lint:js && pnpm lint:css"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@parcel/config-default": "^2.16.4",
    "@parcel/core": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@tailwindcss/postcss": "^4.3.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "parcel": "^2.16.4",
    "postcss": "^8.5.14",
    "postcss-import": "^16.1.1",
    "posthtml": "^0.16.7",
    "posthtml-expressions": "^1.11.4",
    "posthtml-include": "^2.0.1",
    "posthtml-inline-svg": "^0.2.0",
    "rimraf": "^6.1.3",
    "stylelint": "^17.11.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "@alpinejs/focus": "^3.15.12",
    "@alpinejs/ui": "^3.15.12",
    "@glidejs/glide": "^3.7.1",
    "alpinejs": "^3.15.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
